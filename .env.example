# Every VITE_* variable here is read at BUILD time by Vite, not at runtime —
# set them in Railway's service variables before/at deploy, or the built
# bundle won't carry them.

# Base URL of the populrbackend service (Railway), no trailing slash.
#
# Example: https://populrbackend-production.up.railway.app
#
# When unset, the app falls back to a fully local/simulated connect flow
# (no real Instagram OAuth) so it still runs standalone in dev.
VITE_API_URL=

# REQUIRED. Origin of the standalone Populr Auth service (Better Auth), a
# different Railway service from both this app and the backend API. The auth
# client throws on import when this is missing — a build without it renders
# nothing at all — and there is deliberately no localhost fallback, since a
# production build silently pointing auth at its own origin would be worse.
#
# Example: https://populr-auth.up.railway.app
VITE_AUTH_URL=

# Optional. Hosted checkout URL used by the subscription-required prompt when
# Zernio reports the workspace's plan doesn't cover an action. Unset simply
# means no checkout link is offered.
VITE_SUBSCRIPTION_CHECKOUT_URL=
