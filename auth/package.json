{
  "name": "populr-auth",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Populr Auth service (Better Auth + PostgreSQL) providing sessions and JWT/JWKS for the Populr backend.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx tests/run.ts"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "kysely": "^0.28.17",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
