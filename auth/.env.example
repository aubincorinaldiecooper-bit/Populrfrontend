# Populr's existing Postgres database, reached through its own connection
# string so this service's DB access is independently configurable. Better
# Auth's tables are created in the `auth` schema, never `public`, so they
# never collide with the existing Populr application tables.
#
# TLS is controlled entirely by ?sslmode on this URL — the app never
# overrides it. Use `verify-full` (or `require`) for a normal database with
# a certificate a standard CA trust store already trusts. Only add
# `no-verify` for a specific database you know uses a self-signed
# certificate (e.g. some managed-Postgres internal endpoints); it disables
# certificate verification and should never be a default choice.
AUTH_DATABASE_URL=postgresql://user:password@host:5432/populr?sslmode=verify-full

# Secret used for session/token signing and encryption. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL this service is reachable at (its own Railway domain).
BETTER_AUTH_URL=https://populr-auth.up.railway.app

# The Populr frontend's origin. Used for CORS and as the sole trusted
# origin for cookies/callbackURL params.
POPULR_FRONTEND_URL=https://app.populr.example

NODE_ENV=development
PORT=4001

# Optional: Google sign-in stays disabled (not offered at all) until both
# of these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
